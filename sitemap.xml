---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% for page in site.pages %}
  {% unless page.sitemap == false or page.url contains '.xml' or page.url == '/redirects.json' %}
  <url>
    <loc>https://docs.bleachbit.org{{ page.url }}</loc>
  </url>
  {% endunless %}
  {% endfor %}
  {% for post in site.posts %}
  {% unless post.sitemap == false %}
  <url>
    <loc>https://docs.bleachbit.org{{ post.url }}</loc>
  </url>
  {% endunless %}
  {% endfor %}
</urlset>
